/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 10);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 10);   // ~10 m/s, Re ~ 1.2e4
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 10);
    }
    fluid_to_solid
    {
        type            noSlip;
    }
}

// ************************************************************************* //
