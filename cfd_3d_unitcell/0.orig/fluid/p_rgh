FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 3e6;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 3e6;
    }
    fluid_to_solid
    {
        type            fixedFluxPressure;
        value           uniform 3e6;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 3e6;
    }
}

