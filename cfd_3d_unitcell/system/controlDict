/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Custom temperature-based solid CHT solver (see solver-chtMultiRegionTFoam/).
// Solving the solid in T (not enthalpy) removes the variable-Cp discretisation
// bias of the stock chtMultiRegionFoam. Build it once with:
//   bash solver-chtMultiRegionTFoam/Allwmake
application     chtMultiRegionTFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         4000;        // steady-state pseudo-iterations
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

maxCo           0.6;
maxDi           10;

// ************************************************************************* //
